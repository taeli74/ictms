# 프론트(공개돼도 되는 값) — .env.local 로 복사해서 채우세요. Vercel 환경변수에도 똑같이 넣습니다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# 로그인 아이디 뒤에 붙는 가짜 이메일 도메인 (아이디 admin → admin@ictms.local)
VITE_LOGIN_DOMAIN=ictms.local
# 데모 배포에서만: 둘러보기 마지막 화면의 "계정으로 입력" 버튼 (형식: 이름:아이디:비밀번호,...)
VITE_DEMO_ACCOUNTS=
